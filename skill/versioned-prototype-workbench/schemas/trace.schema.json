{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/versioned-prototype-workbench/trace.schema.json",
  "title": "Git and change-request trace",
  "type": "object",
  "required": ["schemaVersion", "version", "repository", "changeRequest", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "version": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "repository": {
      "type": ["object", "null"],
      "properties": {
        "baselineCommit": { "$ref": "#/$defs/commit" },
        "implementationCommit": { "$ref": "#/$defs/commit" }
      },
      "required": ["baselineCommit", "implementationCommit"],
      "additionalProperties": false
    },
    "changeRequest": {
      "type": "object",
      "required": ["kind", "id", "url", "headCommit", "mergeCommit"],
      "properties": {
        "kind": { "enum": ["mr", "pr", null] },
        "id": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "headCommit": { "$ref": "#/$defs/commit" },
        "mergeCommit": { "$ref": "#/$defs/commit" }
      },
      "additionalProperties": false
    },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": { "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" } }
}
