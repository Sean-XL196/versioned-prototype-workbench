{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/versioned-prototype-workbench/evidence.schema.json",
  "title": "Specification evidence index",
  "type": "object",
  "required": ["schemaVersion", "version", "entries"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "version": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^(SRC|ASIS|CHG|REQ|INT|RULE|TST|ALN)-[0-9]{3,}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": { "enum": ["source", "as-is", "change", "requirement", "interaction", "rule", "test", "alignment"] },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] },
          "symbol": { "type": ["string", "null"] },
          "sourceIds": { "$ref": "#/$defs/ids" },
          "evidenceIds": { "$ref": "#/$defs/ids" },
          "requirementIds": { "$ref": "#/$defs/ids" },
          "testIds": { "$ref": "#/$defs/ids" },
          "prototypeTargets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ids": { "type": "array", "items": { "type": "string", "pattern": "^(SRC|ASIS|CHG|REQ|INT|RULE|TST|ALN)-[0-9]{3,}$" }, "uniqueItems": true }
  }
}
